# ════════════════════════════════════════════════════════════════════════════
# WhatsApp AI Auto-Responder — Environment Configuration
# Copy this file to `.env` and fill in your values.
# ════════════════════════════════════════════════════════════════════════════

# ── AI PROVIDER KEYS (provide at least one) ─────────────────────────────────
# Multiple keys per provider are supported for round-robin & rate-limit fallback.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

GROQ_API_KEY_1=
GROQ_API_KEY_2=

OPENAI_API_KEY_1=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY_1=

# ── MODELS ───────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# ── STT SERVER (Whisper HTTP API) ────────────────────────────────────────────
STT_SERVER_URL=http://localhost:8080
STT_TIMEOUT=30
STT_FALLBACK_LOCAL=true

# ── ADMIN API SERVER ────────────────────────────────────────────────────────
ADMIN_HOST=127.0.0.1
ADMIN_PORT=5000
ADMIN_API_TOKEN=change-this-to-a-long-random-string

# ── HUMAN BEHAVIOR (anti-detection) ─────────────────────────────────────────
# Reply delays are PER-WORD with jitter, not fixed.
REPLY_DELAY_MIN=2.5
REPLY_DELAY_MAX=6.0
TYPING_SPEED_WPM_MIN=55
TYPING_SPEED_WPM_MAX=85
READING_SPEED_CPM_MIN=400
READING_SPEED_CPM_MAX=900
BATCH_WINDOW_SECS=4.0

# ── SCANNER ─────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MIN=1.5
SCAN_INTERVAL_MAX=3.0
SCAN_SIDEBAR_LIMIT=50

# ── WORKER THREADS ──────────────────────────────────────────────────────────
AUTO_SENDER_INTERVAL=2
RETRY_WORKER_INTERVAL=5
MAX_CONCURRENT_SENDS=1

# ── AI TUNING ───────────────────────────────────────────────────────────────
GEMINI_MAX_CHARS=80000
GROQ_MAX_CHARS=24000
OPENAI_MAX_CHARS=60000
SUMMARY_THRESHOLD=60
SUMMARY_KEEP=30
SUMMARY_MIN_INTERVAL_SECS=600
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3

# ── RETRY QUEUE ─────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=4
RETRY_BACKOFF_BASE=5
RETRY_BACKOFF_MAX=600

# ── SAFETY ──────────────────────────────────────────────────────────────────
# Per-contact max replies per hour (anti-spam)
RATE_LIMIT_PER_HOUR=20
# Cool-down after rate limit hit (seconds)
RATE_LIMIT_COOLDOWN=900

# ── WEBHOOK (optional) ──────────────────────────────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── OBSERVABILITY ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10
METRICS_ENABLED=true

# ── BROWSER ─────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=false
BROWSER_USER_DATA_DIR=data/whatsapp_session
BROWSER_PROXY=
BROWSER_TIMEZONE=Asia/Karachi
BROWSER_LOCALE=en-US

# ── WPP.JS ──────────────────────────────────────────────────────────────────
# Pin a specific release instead of "nightly" for stability.
# Get the latest stable URL from: https://github.com/wppconnect-team/wa-js/releases
WPP_JS_URL=https://github.com/wppconnect-team/wa-js/releases/download/nightly/wppconnect-wa.js
WPP_JS_LOCAL_CACHE=data/wppconnect-wa.js
WPP_INJECTION_TIMEOUT=30
